{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "steward.output-guidance.v1"
    },
    "advisory": {
      "type": "boolean",
      "default": true
    },
    "original_goal": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_step": {
      "type": "string"
    },
    "next_argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "precondition": {
      "type": "string"
    },
    "verify_argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify_expected": {
      "type": "string"
    },
    "return_to_goal": {
      "type": "string"
    },
    "expand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "observation",
    "basis",
    "uncertainty",
    "next_step",
    "precondition",
    "verify_expected",
    "return_to_goal",
    "expand"
  ]
}
