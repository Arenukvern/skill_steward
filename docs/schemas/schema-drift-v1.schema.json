{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arenukvern/skill_steward/schemas/schema-drift-v1.schema.json",
  "title": "Steward schema drift output v1",
  "type": "object",
  "required": [
    "schema_version",
    "valid",
    "checks",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "steward.schema.drift.v1"
    },
    "valid": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "valid",
          "diagnostics"
        ],
        "properties": {
          "schema": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
