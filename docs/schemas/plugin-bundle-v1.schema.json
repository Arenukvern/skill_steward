{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arenukvern/skill_steward/schemas/plugin-bundle-v1.schema.json",
  "title": "Steward plugin bundle v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "description",
    "source_manifest",
    "source_manifest_sha256",
    "referenced_skills",
    "target_agents",
    "wiring_artifacts",
    "lifecycle",
    "generated_artifacts",
    "managed_blocks"
  ],
  "properties": {
    "schema": { "const": "steward/plugin-bundle/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source_manifest": { "type": "string", "minLength": 1 },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "referenced_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "target_agents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "targets": { "type": "object" },
    "wiring_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "source_path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["install", "update", "uninstall"],
      "properties": {
        "install": { "$ref": "#/$defs/actions" },
        "update": { "$ref": "#/$defs/actions" },
        "uninstall": { "$ref": "#/$defs/actions" }
      },
      "additionalProperties": true
    },
    "generated_artifacts": { "type": "array" },
    "managed_blocks": { "type": "array" },
    "conflict_policy": { "type": "string" },
    "reproducibility": { "type": "object" }
  },
  "$defs": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
