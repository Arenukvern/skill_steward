{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arenukvern/skill_steward/schemas/plugin-bundle-index-v1.schema.json",
  "title": "Steward plugin bundle index v1",
  "type": "object",
  "required": ["schema", "bundles"],
  "properties": {
    "schema": { "const": "steward/plugin-bundle-index/v1" },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "source_manifest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_manifest": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
