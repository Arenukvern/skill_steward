{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arenukvern/skill_steward/schemas/doctor-v1.schema.json",
  "title": "Steward doctor output v1",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "config",
    "repo",
    "harness",
    "stewardship_pillars",
    "diagnostics",
    "actions",
    "probes",
    "next_actions"
  ],
  "properties": {
    "schema_version": { "const": "steward.doctor.v1" },
    "root": { "type": "string", "minLength": 1 },
    "config": { "type": "object" },
    "repo": { "type": "object" },
    "harness": { "type": "object" },
    "stewardship_pillars": { "type": "array", "items": { "type": "string" } },
    "diagnostics": { "type": "array" },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action_summary"
      }
    },
    "probes": { "type": "object" },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action_summary"
      }
    }
  },
  "$defs": {
    "action_summary": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "desc",
        "safety",
        "effects",
        "auto_eligible",
        "quick_eligible"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "desc": { "type": "string" },
        "safety": { "type": "object" },
        "effects": { "type": "object" },
        "auto_eligible": { "type": "boolean" },
        "quick_eligible": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
