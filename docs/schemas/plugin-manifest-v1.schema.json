{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arenukvern/skill_steward/schemas/plugin-manifest-v1.schema.json",
  "title": "Steward plugin manifest v1",
  "type": "object",
  "required": ["schema", "id", "version", "description", "referenced_skills", "target_agents", "install", "update", "uninstall"],
  "properties": {
    "schema": { "const": "steward/plugin-manifest/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "number"] },
    "description": { "type": "string", "minLength": 1 },
    "referenced_skills": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "target_agents": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "targets": { "type": "object" },
    "wiring_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "conflict_policy": { "type": "string" },
    "install": { "$ref": "#/$defs/lifecycle" },
    "update": { "$ref": "#/$defs/lifecycle" },
    "uninstall": { "$ref": "#/$defs/lifecycle" },
    "reproducibility": { "type": "object" }
  },
  "$defs": {
    "lifecycle": {
      "type": "object",
      "required": ["actions"],
      "properties": {
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
