{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arenukvern/skill_steward/schemas/unknown-case-v1.schema.json",
  "title": "Steward unknown case v1",
  "type": "object",
  "required": ["schema", "case_id", "status", "source_observation", "created_at", "evidence"],
  "properties": {
    "schema": { "const": "steward/unknown-case/v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "status": { "const": "unknown_case" },
    "source_observation": { "type": "object" },
    "created_at": { "type": "string", "minLength": 1 },
    "evidence": { "type": "object" }
  },
  "additionalProperties": true
}
